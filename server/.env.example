PORT=5000
CLIENT_URL=http://localhost:5173

# Required for persistent data and authentication in a live deployment.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/<database>?retryWrites=true&w=majority
FIREBASE_ADMIN_SDK_KEY=PLACEHOLDER

# Needed for AI classification and photo uploads.
GEMINI_API_KEY=your-gemini-api-key
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# Optional reCAPTCHA verification and application limits.
RECAPTCHA_SECRET_KEY=
MAX_REPORTS_PER_DAY=15
FLAGGED_REPORT_THRESHOLD=3
CAPTAIN_INACTIVITY_HOURS=4
