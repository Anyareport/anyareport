# Server port
PORT=5000

# MongoDB Atlas connection string
# Leave blank for demo mode; add a real URI later when you want persistence
MONGODB_URI=

# Firebase Admin SDK — paste full JSON string OR path to service account file
# Leave blank for demo mode; add a real key later when you want live auth
FIREBASE_ADMIN_SDK_KEY=

# Firebase project ID (also extractable from admin SDK JSON)
FIREBASE_PROJECT_ID=

# reCAPTCHA v3 secret key (https://www.google.com/recaptcha/admin)
RECAPTCHA_SECRET_KEY=

# Gemini API key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# ORIGINAL
# MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/anyareport?retryWrites=true&w=majority

# # Firebase Admin SDK — paste full JSON string OR path to service account file
# FIREBASE_ADMIN_SDK_KEY={"type":"service_account","project_id":"your-project-id","private_key_id":"placeholder","private_key":"-----BEGIN PRIVATE KEY-----\\nPLACEHOLDER\\n-----END PRIVATE KEY-----\\n","client_email":"firebase-adminsdk@your-project.iam.gserviceaccount.com","client_id":"placeholder","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token","auth_provider_x509_cert_url":"https://www.googleapis.com/oauth2/v1/certs","client_x509_cert_url":"https://www.googleapis.com/robot/v1/metadata/x509/firebase-adminsdk%40your-project.iam.gserviceaccount.com"}

# # Firebase project ID (also extractable from admin SDK JSON)
# FIREBASE_PROJECT_ID=your-project-id

# # reCAPTCHA v3 secret key (https://www.google.com/recaptcha/admin)
# RECAPTCHA_SECRET_KEY=your-recaptcha-v3-secret-key

# # Gemini API key (https://aistudio.google.com/apikey)
# GEMINI_API_KEY=your-gemini-api-key

# Anti-abuse config
MAX_REPORTS_PER_DAY=5
FLAGGED_REPORT_THRESHOLD=3

# Client URL for CORS
CLIENT_URL=http://localhost:5173
