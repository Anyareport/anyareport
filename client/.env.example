# Firebase client config (Firebase Console → Project Settings → Your apps → Web app)
# Leave these blank for demo mode; fill them later when wiring real Firebase Auth
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ORIGINAL
# VITE_FIREBASE_API_KEY=your-firebase-api-key
# VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
# VITE_FIREBASE_PROJECT_ID=your-project-id
# VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
# VITE_FIREBASE_MESSAGING_SENDER_ID=123456789
# VITE_FIREBASE_APP_ID=1:123456789:web:abcdef

# # reCAPTCHA v3 site key
# VITE_RECAPTCHA_SITE_KEY=your-recaptcha-v3-site-key


# reCAPTCHA v3 site key
VITE_RECAPTCHA_SITE_KEY=

# Backend API URL
VITE_API_URL=http://localhost:5000 

# Socket.io server URL
VITE_SOCKET_URL=http://localhost:5000
